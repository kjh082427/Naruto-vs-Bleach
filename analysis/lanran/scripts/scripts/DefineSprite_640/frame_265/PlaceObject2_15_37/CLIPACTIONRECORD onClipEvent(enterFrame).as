onClipEvent(enterFrame){
   if(gameRunning())
   {
      if(bishaSuper())
      {
         _parent.gotoAndPlay("超必杀");
      }
      if(bishaUP())
      {
         _parent.gotoAndPlay("上必杀");
      }
      if(bisha())
      {
         _parent.gotoAndPlay("必杀");
      }
      if(nornalhit(true))
      {
         _parent.gotoAndPlay("砍4");
      }
      if(magichit1())
      {
         _parent.gotoAndPlay("招1");
      }
      if(rush())
      {
         _parent.gotoAndPlay("瞬步");
      }
   }
}
