onClipEvent(enterFrame){
   if(gameRunning())
   {
      if(nornalhit(true))
      {
         _parent.gotoAndPlay("砍3");
      }
      if(bisha())
      {
         _parent.gotoAndPlay("必杀");
      }
      if(skill1())
      {
         _parent.gotoAndPlay("砍技1");
      }
      if(magichit1())
      {
         _parent.gotoAndPlay("招1");
      }
   }
}
