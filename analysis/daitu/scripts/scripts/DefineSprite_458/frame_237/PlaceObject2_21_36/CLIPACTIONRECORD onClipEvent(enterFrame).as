onClipEvent(enterFrame){
   if(gameRunning())
   {
      if(bishaSuper())
      {
         _parent.gotoAndPlay("超必杀");
      }
      if(bisha())
      {
         _parent.gotoAndPlay("必杀");
      }
      if(bishaUP())
      {
         _parent.gotoAndPlay("上必杀");
      }
      if(magichit2())
      {
         _parent.gotoAndPlay("招2");
      }
      if(nornalhit())
      {
         _parent.gotoAndPlay("砍5");
      }
      if(rush())
      {
         _parent.gotoAndPlay("瞬步");
      }
   }
}
