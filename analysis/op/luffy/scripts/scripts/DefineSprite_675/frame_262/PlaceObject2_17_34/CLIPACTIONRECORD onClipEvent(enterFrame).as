onClipEvent(enterFrame){
   if(gameRunning())
   {
      if(nornalhit(true))
      {
         _parent.gotoAndPlay("砍3");
      }
      if(bishaSuper())
      {
         _parent.gotoAndPlay("超必杀");
      }
      if(skill1())
      {
         _parent.gotoAndPlay("砍技1");
      }
      if(magichit2())
      {
         _parent.gotoAndPlay("招22");
      }
      if(magichit())
      {
         _parent.gotoAndPlay("招");
      }
      if(rush())
      {
         _parent.gotoAndPlay("瞬步");
      }
   }
}
