onClipEvent(enterFrame){
   if(gameRunning())
   {
      if(bishaSuper())
      {
         _parent.gotoAndPlay("超必杀");
      }
      if(skill1())
      {
         _parent.gotoAndPlay("砍技1");
      }
      if(skill2())
      {
         _parent.gotoAndPlay("砍技2");
      }
      if(magichit2())
      {
         _parent.gotoAndPlay("招2");
      }
      if(nornalhit(true))
      {
         _parent.gotoAndPlay("砍4");
      }
   }
}
