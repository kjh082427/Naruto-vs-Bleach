onClipEvent(enterFrame){
   if(gameRunning())
   {
      if(bishaSuper())
      {
         _parent.gotoAndPlay("超必杀");
      }
      if(nornalhit())
      {
         _parent.gotoAndPlay("砍3");
      }
      if(skill2())
      {
         _parent.gotoAndPlay("砍技2");
      }
      if(magichit2())
      {
         _parent.gotoAndPlay("招2");
      }
      if(bisha())
      {
         _parent.gotoAndPlay("必杀");
      }
      if(rush())
      {
         _parent.gotoAndPlay("瞬步");
      }
      if(jump())
      {
         _parent.gotoAndPlay("跳");
      }
   }
}
